            { "id": "c2", "name": "link_resena", "value": "https://g.page/r/TU_ENLACE_DE_RESENA/review", "type": "string" },
            { "id": "c3", "name": "evolution_url", "value": "http://evolution-api:8080", "type": "string" },
            { "id": "c4", "name": "evolution_instancia", "value": "principal", "type": "string" },
            { "id": "c5", "name": "evolution_apikey", "value": "CAMBIA_ESTA_API_KEY", "type": "string" }
          ]
