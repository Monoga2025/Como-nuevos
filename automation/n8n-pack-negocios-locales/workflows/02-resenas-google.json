      "id": "leer-ventas",
      "name": "Leer Ventas",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-140, 100]
    },
    {
      "parameters": {
        "jsCode": "// Ventas de AYER a las que no se les ha pedido reseña\nfunction aFecha(v) {\n  if (!v) return null;\n  v = String(v).trim();\n  let m = v.match(/^(\\d{4})-(\\d{1,2})-(\\d{1,2})/);\n  if (m) return new Date(+m[1], +m[2] - 1, +m[3]);\n  m = v.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})/);\n  if (m) return new Date(+m[3], +m[2] - 1, +m[1]);\n  const d = new Date(v);\n  return isNaN(d) ? null : d;\n}\nfunction normTel(t) {\n  t = String(t || '').replace(/\\D/g, '');\n  if (t.length === 10 && t.startsWith('3')) t = '57' + t;\n  return t;\n}\nconst ayer = new Date();\nayer.setDate(ayer.getDate() - 1);\nayer.setHours(0, 0, 0, 0);\n\nconst salida = [];\nfor (const item of $input.all()) {\n  const fila = item.json;\n  const fecha = aFecha(fila.Fecha);\n  const yaPedida = String(fila['ReseñaPedida'] || fila.ResenaPedida || '').trim().toUpperCase() === 'SI';\n  const tel = normTel(fila.Telefono);\n  if (fecha && fecha.getTime() === ayer.getTime() && !yaPedida && tel) {\n    salida.push({ json: { ...fila, telefono_normalizado: tel } });\n  }\n}\nreturn salida;"
      },
      "id": "filtrar-ventas",
      "name": "Filtrar Ventas de Ayer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, 100]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-02",
      "name": "Loop Ventas",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [260, 100]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "content": "=Escribe un mensaje corto de WhatsApp (máximo 4 líneas, tono cálido colombiano, 1-2 emojis) de parte del negocio \"{{ $('⚙️ Config').first().json.nombre_negocio }}\" para {{ $('Loop Ventas').first().json.Nombre }}, que ayer compró \"{{ $('Loop Ventas').first().json.Producto }}\". Agradécele la compra, pregúntale cómo le ha ido con el producto y pídele amablemente que deje una reseña en Google en este enlace: {{ $('⚙️ Config').first().json.link_resena }}\nResponde SOLO con el texto del mensaje, sin comillas ni explicaciones.",
              "role": "user"
            }
          ]
        },
        "options": {}
      },
      "id": "ia-mensaje-02",
      "name": "IA Redacta Mensaje",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [460, 120]
    },
    {
      "parameters": {
        "jsCode": "const venta = $('Loop Ventas').first().json;\nconst r = $json;\nconst mensaje = (r.message?.content || r.output || r.text || '').trim();\nreturn [{ json: { telefono: venta.telefono_normalizado, mensaje, row_number: venta.row_number } }];"
      },
      "id": "preparar-02",
      "name": "Preparar Envío",
