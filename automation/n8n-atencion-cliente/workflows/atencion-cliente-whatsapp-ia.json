    {
      "parameters": {
        "jsCode": "// Normaliza el payload de Evolution API (MESSAGES_UPSERT) a un formato único\nconst body = $('Webhook Evolution').first().json.body;\nconst data = body.data || {};\nconst key = data.key || {};\nconst msg = data.message || {};\n\nconst telefono = String(key.remoteJid || '').split('@')[0];\nconst nombre = data.pushName || 'Cliente';\nconst messageId = key.id || '';\n\nlet tipo = 'no_soportado';\nlet texto = '';\n\nif (msg.conversation) {\n  tipo = 'texto';\n  texto = msg.conversation;\n} else if (msg.extendedTextMessage?.text) {\n  tipo = 'texto';\n  texto = msg.extendedTextMessage.text;\n} else if (msg.buttonsResponseMessage?.selectedDisplayText) {\n  tipo = 'texto';\n  texto = msg.buttonsResponseMessage.selectedDisplayText;\n} else if (msg.listResponseMessage?.title) {\n  tipo = 'texto';\n  texto = msg.listResponseMessage.title;\n} else if (msg.audioMessage) {\n  tipo = 'audio';\n} else if (msg.imageMessage) {\n  tipo = 'imagen';\n  texto = msg.imageMessage.caption || '';\n} else if (msg.documentMessage) {\n  tipo = 'texto';\n  texto = '[El cliente envió un documento adjunto: ' + (msg.documentMessage.fileName || 'archivo') + ']';\n} else if (msg.locationMessage) {\n  tipo = 'texto';\n  texto = '[El cliente compartió su ubicación]';\n}\n\nreturn [{ json: { telefono, nombre, messageId, tipo, texto } }];"
      },
