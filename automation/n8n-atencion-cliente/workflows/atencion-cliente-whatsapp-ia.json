      "parameters": {
        "jsCode": "// Reconstruye el mensaje normalizado con el análisis de la imagen\nconst base = $('Normalizar Mensaje').first().json;\nconst analisis = $json.content || $json.text || '';\nconst caption = base.texto ? ' Texto que acompaña la imagen: \"' + base.texto + '\"' : '';\nreturn [{ json: { ...base, tipo: 'texto', texto: '[El cliente envió una imagen. Contenido: ' + analisis + ']' + caption } }];"
