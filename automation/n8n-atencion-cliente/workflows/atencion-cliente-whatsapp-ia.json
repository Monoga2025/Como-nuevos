      "position": [2520, -220]
    },
    {
      "parameters": {
        "jsCode": "// Limpia el marcador de escalamiento y divide la respuesta en mensajes cortos\n// con retraso proporcional (simula escritura humana en WhatsApp)\nconst salida = $('Agente IA Atención al Cliente').first().json.output || '';\nconst texto = salida.replace(/\\[ESCALAR_HUMANO\\]/g, '').trim();\nif (!texto) return [];\n\nconst MAX = 1200;\nconst bloques = [];\nfor (const parrafo of texto.split(/\\n\\n+/)) {\n  const p = parrafo.trim();\n  if (!p) continue;\n  if (p.length <= MAX) {\n    bloques.push(p);\n  } else {\n    // divide párrafos muy largos por frases\n    let actual = '';\n    for (const frase of p.split(/(?<=[.!?])\\s+/)) {\n      if ((actual + ' ' + frase).trim().length > MAX) {\n        if (actual) bloques.push(actual.trim());\n        actual = frase;\n      } else {\n        actual = (actual + ' ' + frase).trim();\n      }\n    }\n    if (actual) bloques.push(actual.trim());\n  }\n}\n\nconst telefono = $('Normalizar Mensaje').first().json.telefono;\nreturn bloques.map((b) => ({ json: {\n  telefono,\n  texto: b,\n  // 35 ms por carácter, entre 1.2 y 5 segundos de 'escribiendo…'\n  delay: Math.min(Math.max(Math.round(b.length * 35), 1200), 5000)\n} }));"
      },
