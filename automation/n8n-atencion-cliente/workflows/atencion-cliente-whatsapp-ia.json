      "parameters": {
        "jsCode": "// Une todos los mensajes acumulados del cliente en un solo texto\nconst datos = $('Leer Buffer Completo').first().json;\nlet mensajes = datos.mensajes || [];\nif (typeof mensajes === 'string') mensajes = [mensajes];\nconst base = $('Normalizar Mensaje').first().json;\nreturn [{ json: {\n  telefono: base.telefono,\n  nombre: base.nombre,\n  mensajeCompleto: mensajes.join('\\n').trim() || base.texto\n} }];"
      },
