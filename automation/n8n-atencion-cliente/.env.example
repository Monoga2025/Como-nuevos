# ==========================================================
# Copia este archivo a .env y CAMBIA todas las claves
#   cp .env.example .env
# ==========================================================

# --- PostgreSQL ---
POSTGRES_USER=atencion
POSTGRES_PASSWORD=cambia-esta-clave-segura

# --- Evolution API ---
# Clave maestra para crear instancias y autenticar peticiones (header apikey)
EVOLUTION_API_KEY=genera-una-clave-larga-y-aleatoria
# URL pública del servidor Evolution (en producción: https://evolution.tudominio.com)
EVOLUTION_SERVER_URL=http://localhost:8080

# --- n8n ---
# Clave de cifrado de credenciales (genera una con: openssl rand -hex 24)
N8N_ENCRYPTION_KEY=genera-otra-clave-aleatoria
# En producción con dominio propio:
#   N8N_HOST=n8n.tudominio.com
#   N8N_PROTOCOL=https
#   N8N_WEBHOOK_URL=https://n8n.tudominio.com/
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Zona horaria ---
TIMEZONE=America/Bogota
